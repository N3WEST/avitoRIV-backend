export const fail = (status, error) => Object.assign(new Error(error), { status });

// убираем управляющие символы и лишние пробелы, режем по длине
export function cleanText(v, max = 120) {
  return String(v ?? '').replace(/[\u0000-\u001f\u007f<>]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, max);
}

export const cleanRegion = v => (/^[a-z0-9_-]{1,40}$/.test(String(v || '')) && v !== 'all' ? String(v) : '');

export function cleanPrice(v) {
  const n = Math.round(Number(v));
  return Number.isFinite(n) && n >= 1 && n <= 10_000_000 ? n : null;
}
